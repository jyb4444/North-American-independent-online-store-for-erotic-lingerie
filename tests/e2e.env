# Environment for the E2E / security test server (loaded by playwright.config.ts).
# Everything points at the LOCAL Supabase stack (`supabase start`, ports 554xx) and
# placeholder third-party credentials. The keys below are the public Supabase CLI demo
# keys — safe to commit. Never put real credentials in this file.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
MAILPIT_URL=http://127.0.0.1:55424

NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Storefront API calls go to the local mock in tests/mocks/shopify-storefront.ts.
# Queries the mock does not implement return GraphQL errors, so product pages fall back to
# the app's built-in mock catalogue.
NEXT_PUBLIC_SHOPIFY_DOMAIN=e2e-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=e2e-storefront-token
E2E_SHOPIFY_STOREFRONT_URL=http://127.0.0.1:3199/api/graphql.json
SHOPIFY_GIFT_CARD_HANDLE=gift-card
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_CLIENT_ID=e2e-client-id
SHOPIFY_CLIENT_SECRET=e2e-client-secret
# Admin API calls also go to the local mock (discount codes, order sync, return sync).
SHOPIFY_ADMIN_TOKEN=e2e-admin-token
E2E_SHOPIFY_ADMIN_URL=http://127.0.0.1:3199/admin/graphql.json
REFERRAL_REWARD_AMOUNT=10
REFERRAL_REWARD_MIN_SUBTOTAL=30
SHOPIFY_WEBHOOK_SECRET=e2e-webhook-secret
ORDER_ATTRIBUTION_SECRET=e2e-order-attribution-secret-at-least-32-characters
PASSWORD_RECOVERY_SECRET=e2e-password-recovery-secret-at-least-32-characters

# Analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AI preview off (empty token => 503 without any network call).
HF_TOKEN=
HF_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_WIDTH=768
HF_IMAGE_HEIGHT=1024
HF_INFERENCE_STEPS=4
FAL_KEY=

# Emails are written here as JSON instead of being sent (see deliver() in src/lib/email.ts).
E2E_EMAIL_OUTBOX_DIR=.e2e-outbox
# Dummy Resend key as a second safety net: even if the outbox were bypassed, Resend rejects it.
RESEND_API_KEY=re_e2e_dummy_key
RESEND_FROM_EMAIL=Self Love <e2e@example.com>
CONTACT_RECIPIENT_EMAIL=owner@example.com

CRON_SECRET=e2e-cron-secret
NEWSLETTER_ENABLED=true
NEXT_PUBLIC_NEWSLETTER_ENABLED=true
RESTOCK_ALERTS_ENABLED=true
NEXT_PUBLIC_RESTOCK_ALERTS_ENABLED=true

# Local-only tests exercise the issuer; production default is false.
REFERRAL_REWARDS_ENABLED=true
